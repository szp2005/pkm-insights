---
import BaseLayout from '../../layouts/BaseLayout.astro';
const modules = import.meta.glob('../../../content/posts/*.md', { eager: true });
const posts = Object.entries(modules)
  .map(([path, mod]: [string, any]) => {
    const fm = mod.frontmatter ?? {};
    return {
      slug: fm.slug ?? path.split('/').pop()?.replace(/\.md$/, ''),
      title: fm.title ?? 'Untitled',
      description: fm.description ?? '',
      date: fm.date ? String(fm.date) : '',
    };
  })
  .sort((a, b) => (b.date > a.date ? 1 : -1));
---
<BaseLayout title="All Guides | PKM Insights" description="Browse all PKM guides, second brain tutorials, and digital organization tips." canonicalURL="https://pkm.notes-automate.com/posts/">
  <div style="max-width:860px;margin:0 auto;padding:2rem 1rem">
    <h1>All Guides</h1>
    <ul class="post-list">
      {posts.map(p => (
        <li class="post-item">
          <a href={`/posts/${p.slug}/`}>
            <h3>{p.title}</h3>
            {p.description && <p>{p.description}</p>}
            {p.date && <time>{p.date}</time>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
<style>
.post-list { list-style: none; padding: 0; display: grid; gap: 1rem; }
.post-item a { display: block; padding: 1.25rem; border: 1px solid #e5e7eb; border-radius: 8px; text-decoration: none; color: inherit; }
.post-item a:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.07); }
.post-item h3 { font-size: 1.05rem; font-weight: 600; margin: 0 0 0.4rem; }
.post-item p { color: #6b7280; font-size: 0.9rem; margin: 0 0 0.5rem; }
.post-item time { color: #9ca3af; font-size: 0.82rem; }
</style>
